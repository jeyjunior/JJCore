<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Version>2.2.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>José Junior</Authors>
    <Company>José Junior</Company>
    <Product>JJCore</Product>
    <RepositoryUrl>https://github.com/jeyjunior/JJCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/jeyjunior/JJCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Fixes UpdateAsync writing the key value into a non-key property named Id, NULL byte[] values on SQL Server, cancellation tokens passed without a parameters argument, indexers and static properties mapped as columns, cancelled tokens ignored by AsyncUnitOfWork, MySQL bracket translation after a word and in executable comments, and .NET Framework builds with the SQLite package.</PackageReleaseNotes>
    <PackageTags>jjcore;dapper;database;sqlserver;sqlite;postgresql;supabase;mysql;mariadb</PackageTags>
  </PropertyGroup>
</Project>
