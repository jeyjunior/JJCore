<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Version>2.2.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>José Junior</Authors>
    <Company>José Junior</Company>
    <Product>JJCore</Product>
    <RepositoryUrl>https://github.com/jeyjunior/JJCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/jeyjunior/JJCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Adds GetByIdAsync and GetByConditionAsync and marks GetAsync as obsolete, because its string overload executed key values as SQL. PostgreSQL and MySQL identifier translation now preserves string literals, comments, dollar-quoted strings, and array expressions.</PackageReleaseNotes>
    <PackageTags>jjcore;dapper;database;sqlserver;sqlite;postgresql;supabase;mysql;mariadb</PackageTags>
  </PropertyGroup>
</Project>
