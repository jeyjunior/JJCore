<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Version>2.3.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>José Junior</Authors>
    <Company>José Junior</Company>
    <Product>JJCore</Product>
    <RepositoryUrl>https://github.com/jeyjunior/JJCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/jeyjunior/JJCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Returns database-generated Guid and string keys on SQL Server and SQLite, and rejects them before the insert on MySQL instead of returning another row's key. Reads Guid values on SQLite, rejects transactions ended by the server, sends DateTime as datetime2 on SQL Server, ignores computed properties, writes unfilled DateTimeOffset as NULL, and adds RawSql, Repository.DeleteAsync(object), condition-and-token overloads, and an optional UTC reader for DateTimeOffset on MySQL.</PackageReleaseNotes>
    <PackageTags>jjcore;dapper;database;sqlserver;sqlite;postgresql;supabase;mysql;mariadb</PackageTags>
  </PropertyGroup>
</Project>
